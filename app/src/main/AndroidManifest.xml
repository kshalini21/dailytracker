<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DailyTrackApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyTrack">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DailyTrack.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.tasks.AddEditTaskActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.notes.AddEditNoteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.notes.NoteDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.progress.ProgressActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.schedule.ScheduleActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.exam.ExamActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

        <activity
            android:name=".ui.focus.FocusActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyTrack.NoActionBar" />

    </application>

</manifest>
